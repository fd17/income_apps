{
  "name": "income-apps",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for building and deploying multiple income-generating websites.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,astro,md,mdx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,astro,md,mdx,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  }
}
