---
import BaseLayout from '@repo/ui/BaseLayout.astro';
import Button from '@repo/ui/Button.astro';
import { site } from '../site';

const base = import.meta.env.BASE_URL;
const homeHref = base;
---

<BaseLayout site={site} page="Support" description="Support this project">
  <main class="container" style="padding-top: 12vh; padding-bottom: 8vh; max-width: 640px;">
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 16px;">Support this project</h1>
    <p style="font-size: 1.1rem; color: var(--muted);">
      This is a placeholder for a donation or checkout flow. Wire it to a free-tier payment provider
      (for example a Stripe Payment Link or a "Buy me a coffee" button) when the site is ready to
      earn.
    </p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px;">
      <Button href="#">Donate (placeholder)</Button>
      <Button href={homeHref} variant="ghost">Back home</Button>
    </div>
  </main>
</BaseLayout>
