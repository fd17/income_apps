# Public, absolute URL the site is deployed to. Used for canonical + OG tags.
SITE_URL=https://example.com

# Path the site is served under. Use "/" for Cloudflare Pages / Netlify / Vercel
# and "/<repo>/" for a GitHub Pages project site. Defaults to "/".
BASE_PATH=/

# Stripe Payment Link (or Polar / Lemon Squeezy) for the $9 Pro unlock.
# Success URL should be https://<host>/<base>/app/?unlocked=1
PUBLIC_CHECKOUT_URL=

# Optional tip jar (Ko-fi, PayPal.me, Stripe Payment Link).
PUBLIC_DONATE_URL=
