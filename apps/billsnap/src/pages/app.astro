---
import Layout from '../components/Layout.astro';
import { site } from '../site';
---

<Layout
  site={site}
  page="Create invoice"
  description="Create, preview, and download a professional invoice PDF in your browser."
>
  <main class="app-page">
    <div id="billsnap-app"></div>
  </main>
</Layout>

<script>
  import { mount } from '../lib/app';

  const root = document.getElementById('billsnap-app');
  if (root) {
    mount(root, {
      checkoutUrl: import.meta.env.PUBLIC_CHECKOUT_URL ?? '',
      pricingHref: `${import.meta.env.BASE_URL}pricing/`.replace(/\/+/g, '/'),
    });
  }
</script>
